generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// B-02: Enums
enum Role {
  USER
  ADMIN
}

enum CalculatorType {
  ATTA_PRICING
  CONVEYING_CAPACITY
  POWER_SAVING
}

enum ReportStatus {
  ISSUED
  REVOKED
}

enum ConsentDocument {
  TERMS
  PRIVACY
}

// User  (B-01: phone, phoneVerifiedAt)
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  phone           String?   @unique // E.164, required at signup, null only for old accounts
  phoneVerifiedAt DateTime? // reserved for OTP in V2
  hashedPassword  String?
  image           String?
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  companyProfile          CompanyProfile?
  consentRecords          ConsentRecord[]
  reports                 CalculationReport[]

  @@map("users")
}

// Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Password Reset Token
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, token])
  @@map("password_reset_tokens")
}

// Email Verification Token
model EmailVerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, token])
  @@map("email_verification_tokens")
}

// B-03: Company profile (1:1 with user)
model CompanyProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?  @db.VarChar(100)
  city        String?  @db.VarChar(60)
  state       String?  @db.VarChar(60)
  gstin       String?  @db.VarChar(15)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

// B-04: Consent records (append-only)
model ConsentRecord {
  id         String          @id @default(cuid())
  userId     String
  document   ConsentDocument
  version    String
  acceptedAt DateTime        @default(now())
  ipHash     String?
  userAgent  String?         @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document, acceptedAt(sort: Desc)])
  @@map("consent_records")
}

// B-05: Calculation reports (immutable snapshots)
model CalculationReport {
  id                String         @id @default(cuid())
  reportNo          String         @unique
  userId            String
  calculatorType    CalculatorType
  calculatorVersion String
  title             String?        @db.VarChar(120)
  note              String?        @db.VarChar(500)
  inputs            Json
  results           Json
  headline          String?
  issuedTo          Json
  locale            String         @default("en")
  status            ReportStatus   @default(ISSUED)
  revokedAt         DateTime?
  revokedReason     String?        @db.VarChar(300)
  verifyKey         String
  signature         String
  signatureVersion  Int            @default(1)
  idempotencyKey    String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, calculatorType, createdAt(sort: Desc)])
  @@map("calculation_reports")
}

// B-06: Report number counters (per prefix + year)
model ReportCounter {
  prefix    String
  year      Int
  lastValue Int    @default(0)

  @@id([prefix, year])
  @@map("report_counters")
}
